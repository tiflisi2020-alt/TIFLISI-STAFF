# Never commit real secret values. Configure these in the server host dashboard.
NODE_ENV=production
PORT=3000

# Supabase project: https://bbroknpeebjuilycutjd.supabase.co
# Must be service_role or a supported server secret key, not anon/publishable.
SUPABASE_SERVICE_ROLE_KEY=

# Interactive login is Supabase Auth. These names are retained for session signing
# and server compatibility; OAuth endpoints no longer initiate interactive login.
MANUS_PROJECT_ID=
MANUS_OAUTH_PORTAL_URL=
MANUS_OAUTH_API_URL=

# Generate a fresh strong random value for this standalone deployment.
# Do not reuse or export the Manus Preview signing secret.
MANUS_JWT_SECRET=
